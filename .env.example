# -------- Database --------
# Production: a pooled Postgres connection string (e.g. from Neon or Supabase).
#   Neon example:     postgresql://<user>:<pwd>@<host>.neon.tech/<db>?sslmode=require
#   Supabase example: postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=""
# Optional direct (non-pooled) connection used by Prisma for migrations.
# Leave empty if your provider doesn't require it (Neon usually does).
DIRECT_URL=""

# -------- NextAuth --------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Production URL of the deployed site, e.g. https://nekhely.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# -------- Payments (optional in dev) --------
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""

# -------- Cloudflare Stream (optional) --------
# When all five variables are set, instructors can upload videos directly to
# Cloudflare and students watch them via signed, short-lived URLs. If any
# variable is missing, the "Upload video" button is gracefully disabled and
# lessons keep working with YouTube / Vimeo / MP4 links.
#
# How to get these:
#   1. Create an API token with "Stream: Edit"  ->  CLOUDFLARE_STREAM_API_TOKEN
#   2. Find your account id on any Cloudflare page sidebar  ->  CLOUDFLARE_ACCOUNT_ID
#   3. Create a signing key:
#        curl -X POST -H "Authorization: Bearer $TOKEN" \
#          https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/stream/keys
#      The response gives you .result.id and .result.pem.
#   4. After uploading your first video, Cloudflare shows your customer
#      subdomain (looks like customer-abc123.cloudflarestream.com).
#
# NOTE on the PEM: keep the literal newlines. On Vercel paste it raw in the
# multi-line textarea — do NOT wrap in quotes.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_SIGNING_KEY_ID=""
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=""
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=""

# -------- Branding --------
NEXT_PUBLIC_SITE_NAME="أكاديمية نَخِيلة"
NEXT_PUBLIC_CURRENCY="SAR"
